# ===== 容器 / 服务 =====
# 宿主机端口（docker compose 使用）
APP_PORT=7788
TZ=Asia/Shanghai
LOG_LEVEL=INFO
# 是否写滚动日志文件到 /app/backend/logs
USE_LOG_FILE=false

# ===== 代理设置 =====
# 元数据抓取走代理（国内网络建议 True）
USE_PROXY=False
PROXY_URL=http://your-proxy-host:port
# 视频下载是否走代理（默认直连 CDN）
USE_DOWNLOAD_PROXY=False
DOWNLOAD_PROXY_URL=http://your-proxy-host:port

# ===== 下载命名模板 =====
# 也可在「下载管理 → 命名设置」中修改，页面设置优先级更高
# 可用变量：title subtitle series studio video_type video_id tags
#           upload_date year month day date duration quality ext
# 留空表示使用默认：子路径为空目录，文件名 {video_id}_{title}
DOWNLOAD_SUB_PATH_TEMPLATE=
DOWNLOAD_FILENAME_TEMPLATE={video_id}_{title}
